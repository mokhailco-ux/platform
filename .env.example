# ============================================================
# انسخ هذا الملف باسم .env.local واملأ القيم بمفاتيحك الحقيقية.
# لا ترفع ملف .env.local أبدًا على GitHub (مستثنى تلقائيًا في .gitignore).
# ============================================================

# من Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# من Moyasar Dashboard → Settings → API Keys
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxx
# من Moyasar Dashboard → Settings → Webhooks (اختر أي نص سرّي وضعه هنا وفي نفس الحقل بالداشبورد)
MOYASAR_WEBHOOK_SECRET=اختر-نص-سري-قوي-هنا

# رابط موقعك الفعلي بعد النشر (بدون / في النهاية)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# بريدك الإلكتروني (نفس البريد اللي ستسجل به حساب طالب من /signup)
# أي حساب يسجّل بهذا البريد يصير أدمن تلقائيًا - بدون أي إعداد إضافي بقاعدة البيانات
ADMIN_EMAIL=ضع-بريدك-هنا@example.com
